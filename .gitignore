# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Build output
[Bb]in/
[Oo]bj/
publish/

# NuGet packages are restored, not committed (packages.config stays tracked)
packages/
*.nupkg

# Signing certificates - never commit private keys
*.pfx
*.snk
*.p12

# Data the app writes next to its own executable
Database/
Posters/
Log/

# Media files, including the zero-byte fixtures used to test the catalogue
*.mkv
*.mp4
*.avi
*.mov
*.m4v
*.wmv
*.mpg
*.mpeg
*.webm
*.iso

# Local-only notes and scripts. Both name one particular machine and network share,
# so they stay on the machine that uses them rather than going out to everyone who clones.
COPY TO NETWORK.bat
RELEASE_GUIDE.md
